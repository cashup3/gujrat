# Copy to .env and fill in. Restart dev server after changes.
#
# Vercel: Project → Settings → Environment Variables — add every VITE_* you use
# (Production + Preview). Redeploy after changing vars. Never commit .env.

# Required for live donate buttons (e.g. Stripe Payment Link, PayPal, Givebutter).
VITE_DONATE_URL=

# Optional second method (e.g. bank instructions page, other provider).
VITE_DONATE_URL_SECONDARY=

# Shown in footer mailto link.
VITE_CONTACT_EMAIL=

# Optional footer social links (full URLs). Icons stay hidden until set.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_FACEBOOK=

# Verified comments (Supabase). Run supabase/comments_schema.sql (or comments_from_v1_migration.sql if you used the old schema).
# Deploy functions from repo root: supabase link && supabase functions deploy submit-comment && supabase functions deploy approve-comment
# Set Edge secret (32+ chars recommended): supabase secrets set ADMIN_APPROVE_SECRET="..."
# Approve a comment: curl -X POST "$SUPABASE_URL/functions/v1/approve-comment" -H "Content-Type: application/json" -H "x-admin-secret: YOUR_SECRET" -d "{\"id\":\"COMMENT_UUID\"}"
#
# Admin portal at /admin — run supabase/site_stats.sql, then:
# supabase functions deploy admin-api
# supabase secrets set ADMIN_PORTAL_SECRET="long-random-string"   (16+ chars; same header x-admin-secret)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
